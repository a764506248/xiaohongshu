APP_ENV=development
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/xiaohongshu
CHECKPOINT_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/xiaohongshu
LLM_PROVIDER=sensenova
LLM_BASE_URL=https://token.sensenova.cn/v1
LLM_MODEL=deepseek-v4-flash
LLM_API_KEY=
LLM_TIMEOUT_SECONDS=120
ALIYUN_MODEL_API_KEY=
ALIYUN_OPENAI_BASE_URL=https://token-plan.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
ALIYUN_ANTHROPIC_BASE_URL=https://token-plan.cn-beijing.maas.aliyuncs.com/apps/anthropic
ALIYUN_MULTIMODAL_BASE_URL=https://token-plan.cn-beijing.maas.aliyuncs.com/api/v1
OPENROUTER_MODEL_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
CORS_ORIGINS=["http://localhost:5173"]
AUTH_SECRET_KEY=replace-with-a-long-random-secret
AUTH_TOKEN_HOURS=12
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=change-me
